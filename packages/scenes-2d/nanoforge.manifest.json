{
  "type": "package",
  "name": "@nanoforge/scenes-2d",
  "version": "1.0.0",
  "description": "Scene vars in a 2D game: a score or lives shown in a text, coins that add to them when picked up, and zones that add to them when entered.",
  "keywords": [
    "scenes",
    "2d",
    "scene vars",
    "score",
    "hud",
    "pickup",
    "collectible",
    "goal",
    "zone"
  ],
  "license": "MIT",
  "suggestedPlugins": ["@nanoforge/ecs"],
  "dependencies": {
    "@nanoforge/basics-2d": "^2.0.0",
    "@nanoforge/graphics-2d": "^2.0.0",
    "@nanoforge/physics-2d": "^2.0.0"
  },
  "libDependencies": {
    "@nanoforge-dev/common": "^3.0.0",
    "@nanoforge-dev/ecs": "^3.0.0",
    "@nanoforge-dev/graphics-2d": "^3.0.0",
    "@nanoforge-dev/scene": "^3.0.0"
  },
  "contents": [
    { "kind": "@nanoforge/ecs:component", "path": "components/" },
    { "kind": "@nanoforge/ecs:system", "path": "systems/" }
  ]
}
