{
  "type": "package",
  "name": "@nanoforge/controls-2d",
  "version": "2.1.0",
  "description": "Control entities in 2D: walk, jump, aim and fire with the keyboard, the mouse or a gamepad; click, drag and follow the mouse.",
  "keywords": [
    "controls",
    "2d",
    "keyboard",
    "controller",
    "gamepad",
    "mouse",
    "input",
    "player",
    "jump",
    "platformer",
    "shoot",
    "aim"
  ],
  "license": "MIT",
  "suggestedPlugins": ["@nanoforge/ecs"],
  "dependencies": {
    "@nanoforge/basics-2d": "^2.0.0",
    "@nanoforge/combat-2d": "^2.0.0",
    "@nanoforge/graphics-2d": "^2.0.0",
    "@nanoforge/physics-2d": "^2.0.0"
  },
  "libDependencies": {
    "@nanoforge-dev/common": "^3.0.0",
    "@nanoforge-dev/ecs": "^3.0.0",
    "@nanoforge-dev/graphics-2d": "^3.0.0",
    "@nanoforge-dev/input": "^3.0.0"
  },
  "contents": [
    { "kind": "@nanoforge/ecs:component", "path": "components/" },
    { "kind": "@nanoforge/ecs:system", "path": "systems/" }
  ]
}
